---
interface Props {
  done: boolean;
  active?: boolean;
}

const { done, active } = Astro.props;
---

{done ? (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <rect x="1.5" y="1.5" width="13" height="13" fill="#FFFFFF" stroke="#007A00" stroke-width="1.5" />
    <path d="M4.5 8l2.5 2.5 4.5-5" stroke="#007A00" stroke-width="1.8" stroke-linecap="square" />
  </svg>
) : active ? (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <rect x="1.5" y="1.5" width="13" height="13" fill="#FFFFFF" stroke="#16339E" stroke-width="1.5" />
    <rect x="5" y="5" width="6" height="6" fill="#16339E" />
  </svg>
) : (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <rect x="1.5" y="1.5" width="13" height="13" fill="#FFFFFF" stroke="#D9D3C3" stroke-width="1.5" />
  </svg>
)}
