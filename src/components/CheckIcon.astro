---
interface Props {
  done: boolean;
  active?: boolean;
}

const { done, active } = Astro.props;
---

{done ? (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <circle cx="8" cy="8" r="7" fill="rgba(40,200,64,0.15)" stroke="#28C840" stroke-width="1.5" />
    <path d="M5 8l2 2 4-4" stroke="#28C840" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
) : active ? (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <circle cx="8" cy="8" r="7" fill="rgba(0,180,216,0.12)" stroke="#00B4D8" stroke-width="1.5" stroke-dasharray="2 2" />
    <circle cx="8" cy="8" r="2.5" fill="#00B4D8" />
  </svg>
) : (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <circle cx="8" cy="8" r="7" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
  </svg>
)}
