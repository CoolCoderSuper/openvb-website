---
interface Props {
  done: boolean;
  active?: boolean;
}

const { done, active } = Astro.props;
---

{done ? (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <rect x="1.5" y="1.5" width="13" height="13" fill="var(--paper-raised)" stroke="var(--vb-green)" stroke-width="1.5" />
    <path d="M4.5 8l2.5 2.5 4.5-5" stroke="var(--vb-green)" stroke-width="1.8" stroke-linecap="square" />
  </svg>
) : active ? (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <rect x="1.5" y="1.5" width="13" height="13" fill="var(--paper-raised)" stroke="var(--vb-blue)" stroke-width="1.5" />
    <rect x="5" y="5" width="6" height="6" fill="var(--vb-blue)" />
  </svg>
) : (
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none">
    <rect x="1.5" y="1.5" width="13" height="13" fill="var(--paper-raised)" stroke="var(--rule)" stroke-width="1.5" />
  </svg>
)}
