---
const pathname = Astro.url.pathname;

const NAV_LINKS = [
  { label: 'Projects',  href: '/projects',                        external: false },
  { label: 'Roadmap',   href: '/roadmap',                         external: false },
  { label: 'Community', href: '/community',                       external: false },
  { label: 'Docs',      href: '#',                                external: false },
  { label: 'GitHub',    href: 'https://github.com/OpenVBdotnet/', external: true  },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 lg:px-10 py-4 border-b border-white/[0.05] bg-[#07090F]/80 backdrop-blur-xl">
  <a href="/" class="flex items-center gap-2.5">
    <div
      class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold text-white"
      style="background: #00B4D8"
    >
      VB
    </div>
    <span class="font-semibold text-white text-lg tracking-tight">OpenVB</span>
  </a>

  <div class="hidden md:flex items-center gap-8 text-sm text-slate-400">
    {NAV_LINKS.map((link) => {
      const isActive = !link.external && link.href !== '#' && pathname.startsWith(link.href);
      if (link.external) {
        return (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="relative group py-1 transition-colors hover:text-white"
          >
            {link.label}
            <span class="absolute bottom-0 left-0 h-px w-0 bg-[#00B4D8] transition-all duration-300 group-hover:w-full"></span>
          </a>
        );
      }
      return (
        <a
          href={link.href}
          class={`relative group py-1 transition-colors hover:text-white ${isActive ? 'text-white' : ''}`}
        >
          {link.label}
          <span
            class="absolute bottom-0 left-0 h-px bg-[#00B4D8] transition-all duration-300 group-hover:w-full"
            style={`width: ${isActive ? '100%' : '0%'}`}
          ></span>
        </a>
      );
    })}
  </div>

  <a
    href="#"
    class="hidden md:flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white border border-white/10 bg-white/[0.05] hover:bg-white/[0.1] hover:border-white/20 transition-all duration-200"
  >
    Get Started
  </a>
</nav>
