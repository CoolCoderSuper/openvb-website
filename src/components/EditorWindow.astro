---
interface Props {
  filename: string;
  code?: string;
}

const { filename, code } = Astro.props;

// ── VB.NET syntax highlighter (classic VB6 / VS light palette) ──────────────

const KEYWORDS = new Set([
  'Module', 'End', 'Sub', 'Function', 'Class', 'Property',
  'Imports', 'Dim', 'As', 'Public', 'Private', 'Protected', 'Friend',
  'Return', 'For', 'Each', 'In', 'Next', 'If', 'Then', 'Else', 'ElseIf',
  'New', 'From', 'Where', 'Order', 'By', 'Select', 'Descending', 'Ascending',
  'Not', 'And', 'Or', 'AndAlso', 'OrElse', 'Is', 'IsNot', 'Like', 'Mod',
  'Let', 'Get', 'Set', 'ReadOnly', 'WriteOnly', 'Shared', 'Static',
  'Interface', 'Implements', 'Inherits', 'Namespace', 'Structure', 'Enum',
  'Try', 'Catch', 'Finally', 'Throw', 'Using', 'With', 'Case', 'Exit',
  'Continue', 'Do', 'Loop', 'While', 'Until', 'Await', 'Async', 'Handles',
  'AddressOf', 'GetType', 'TypeOf', 'ByVal', 'ByRef', 'Optional',
  'ParamArray', 'Overrides', 'Overridable', 'MustOverride', 'Shadows',
  'Overloads', 'True', 'False', 'Nothing', 'Of',
]);

// Built-in type names
const BUILTIN_TYPES = new Set([
  'String', 'Integer', 'Long', 'Short', 'Byte', 'SByte',
  'UInteger', 'ULong', 'UShort', 'Single', 'Double', 'Decimal',
  'Char', 'Date', 'Object', 'Boolean',
]);

// After these keywords, the next bare identifier is a type name
const TYPE_CTX = new Set([
  'As', 'New', 'Class', 'Inherits', 'Implements',
  'Structure', 'Enum', 'Interface', 'Module', 'Imports', 'Of',
]);

// After these keywords, the next bare identifier is a callable name
const FUNC_CTX = new Set(['Sub', 'Function']);

// Theme-aware editor colors (light: VB6-era VS palette, dark: classic VS dark)
const C = {
  keyword: 'var(--code-keyword)',
  type: 'var(--code-type)',
  func: 'var(--code-func)',
  ident: 'var(--code-ident)',
  string: 'var(--code-string)',
  number: 'var(--code-number)',
  comment: 'var(--code-comment)',
};

function esc(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function sp(color: string, text: string) {
  return `<span style="color:${color}">${esc(text)}</span>`;
}

function tokenize(src: string): string {
  let out = '';
  let i   = 0;
  let prev = ''; // most recent keyword token

  while (i < src.length) {
    const ch = src[i];

    // Whitespace — pass through, preserve prev
    if (ch === ' ' || ch === '\t') {
      out += ch;
      i++;
      continue;
    }

    // Comment — rest of line
    if (ch === "'") {
      out += sp(C.comment, src.slice(i));
      break;
    }

    // Interpolated string: $"...{expr}..."
    if (ch === '$' && src[i + 1] === '"') {
      const [html, next] = readInterpString(src, i);
      out += html;
      i = next;
      prev = '';
      continue;
    }

    // Plain string literal
    if (ch === '"') {
      const [html, next] = readPlainString(src, i);
      out += html;
      i = next;
      prev = '';
      continue;
    }

    // Numeric literal
    if (/[0-9]/.test(ch)) {
      const start = i;
      while (i < src.length && /[0-9._]/.test(src[i])) i++;
      out += sp(C.number, src.slice(start, i));
      prev = '';
      continue;
    }

    // Identifier / keyword
    if (/[a-zA-Z_]/.test(ch)) {
      const start = i;
      while (i < src.length && /[a-zA-Z0-9_]/.test(src[i])) i++;
      const word = src.slice(start, i);

      if (KEYWORDS.has(word)) {
        out += sp(C.keyword, word);
        prev = word;
      } else if (BUILTIN_TYPES.has(word)) {
        out += sp(C.type, word);
        prev = '';
      } else if (TYPE_CTX.has(prev)) {
        // e.g. "As Developer", "Class HelloWorld", "New List"
        out += sp(C.type, word);
        prev = '';
      } else if (FUNC_CTX.has(prev)) {
        // e.g. "Sub Main", "Function Greet"
        out += sp(C.func, word);
        prev = '';
      } else {
        // method call if immediately followed by "("
        const ahead = src.slice(i).trimStart();
        out += ahead.startsWith('(')
          ? sp(C.func, word)
          : sp(C.ident, word);
        prev = '';
      }
      continue;
    }

    // Anything else — operators, punctuation
    out += esc(ch);
    prev = '';
    i++;
  }

  return out;
}

function readPlainString(src: string, i: number): [string, number] {
  const start = i;
  i++; // opening "
  while (i < src.length) {
    if (src[i] === '"') {
      i++;
      if (src[i] === '"') { i++; continue; } // doubled-quote escape
      break;
    }
    i++;
  }
  return [sp(C.string, src.slice(start, i)), i];
}

function readInterpString(src: string, i: number): [string, number] {
  let out = sp(C.string, '$"');
  i += 2; // skip $"
  let buf = '';

  const flush = () => {
    if (buf) {
      out += sp(C.string, buf);
      buf = '';
    }
  };

  while (i < src.length) {
    const ch = src[i];

    if (ch === '"') {
      if (src[i + 1] === '"') {
        buf += '""';
        i += 2;
        continue;
      }
      flush();
      out += sp(C.string, '"');
      i++;
      break;
    }

    if (ch === '{') {
      if (src[i + 1] === '{') {
        buf += '{{';
        i += 2;
        continue;
      }
      flush();
      out += esc('{');
      i++;
      const [hole, next] = readInterpHole(src, i);
      out += hole;
      i = next;
      continue;
    }

    if (ch === '}' && src[i + 1] === '}') {
      buf += '}}';
      i += 2;
      continue;
    }

    buf += ch;
    i++;
  }

  flush();
  return [out, i];
}

function readInterpHole(src: string, i: number): [string, number] {
  const start = i;
  let formatAt = -1;
  let depth = 0;
  let parens = 0;
  let inStr = false;
  let phase: 'code' | 'format' = 'code';

  while (i < src.length) {
    const ch = src[i];

    if (phase === 'format') {
      if (ch === '}' && src[i + 1] === '}') { i += 2; continue; }
      if (ch === '}') break;
      i++;
      continue;
    }

    if (inStr) {
      if (ch === '"') {
        if (src[i + 1] === '"') { i += 2; continue; }
        inStr = false;
      }
      i++;
      continue;
    }

    if (ch === '"') { inStr = true; i++; continue; }
    if (ch === '(') { parens++; i++; continue; }
    if (ch === ')') { parens--; i++; continue; }
    if (ch === '{') { depth++; i++; continue; }
    if (ch === '}' && depth > 0) { depth--; i++; continue; }
    if (ch === '}' && depth === 0) break;

    if (ch === ':' && depth === 0 && parens <= 0) {
      formatAt = i;
      phase = 'format';
      i++;
      continue;
    }

    i++;
  }

  const codeEnd = formatAt >= 0 ? formatAt : i;
  let html = tokenize(src.slice(start, codeEnd));
  if (formatAt >= 0) html += sp(C.string, src.slice(formatAt, i));
  if (src[i] === '}') {
    html += esc('}');
    i++;
  }
  return [html, i];
}

function tokenizeLine(line: string): string {
  return tokenize(line) || '&nbsp;';
}

function highlight(raw: string): string {
  return raw
    .trim()
    .split('\n')
    .map(line => tokenizeLine(line))
    .join('\n');
}

const lineNums = code
  ? Array.from({ length: code.trim().split('\n').length }, (_, i) => i + 1)
  : [];

const rendered = code ? highlight(code) : null;
const uid = `ew-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="frame">
  <!-- Tab bar -->
  <div class="frame-header">
    <span class="frame-tab">
      <span class="w-2 h-2 bg-vb-blue shrink-0" aria-hidden="true"></span>
      {filename}
    </span>
    {code && (
      <button
        data-copy-target={uid}
        class="ml-auto mr-3 my-auto cursor-pointer uppercase tracking-[0.1em] text-[11px] text-ink-faint hover:text-vb-blue transition-colors"
        aria-label="Copy code to clipboard"
      >
        <span data-copy-label>Copy</span>
      </button>
    )}
  </div>

  <!-- Code area -->
  <div class="flex text-[13px] font-mono bg-code-bg text-ink px-5 py-5 overflow-x-auto">
    {code ? (
      <>
        <div class="text-ink-faint select-none pr-5 text-right shrink-0 leading-6" style="min-width: 2ch">
          {lineNums.map((n) => <div>{n}</div>)}
        </div>
        <pre id={uid} class="vb-code min-w-0" set:html={rendered} />
      </>
    ) : (
      <slot />
    )}
  </div>

  <!-- Status line -->
  <div class="frame-status">
    <span>VB.NET</span>
    <span>UTF-8</span>
    <span class="hidden sm:inline">LF</span>
    <span class="flex-1"></span>
    <span class="hidden sm:inline text-vb-green">✓ builds everywhere</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.copyTarget!;
      const pre = document.getElementById(targetId);
      if (!pre) return;

      await navigator.clipboard.writeText(pre.textContent ?? '');

      const label = btn.querySelector<HTMLSpanElement>('[data-copy-label]')!;
      label.textContent = 'Copied';

      setTimeout(() => {
        label.textContent = 'Copy';
      }, 2000);
    });
  });
</script>

<style>
  pre.vb-code {
    background: transparent;
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: 1.5rem;
  }
</style>
