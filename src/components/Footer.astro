---
const FOOTER_LINKS = [
  { label: 'GitHub',  href: 'https://github.com/OpenVBdotnet/', external: true  },
  { label: 'Discord', href: 'https://discord.gg/p3w3ryST92',    external: true  },
  { label: 'Docs',    href: '/docs',                            external: false },
  { label: 'License', href: '#',                                external: false },
];
---

<footer class="border-t border-ink mt-auto">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 pt-14 pb-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
      <div>
        <div class="font-serif text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-none">
          OpenVB<span class="text-vb-blue">.</span>
        </div>
        <p class="font-mono text-[12px] text-ink-faint mt-4 tracking-wide">
          Dim future As New VisualBasic()
        </p>
      </div>

      <div class="flex flex-col items-start md:items-end gap-4">
        <div class="flex items-center gap-6">
          {FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="font-mono text-[12px] uppercase tracking-[0.12em] text-ink-soft hover:text-vb-blue transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
        <p class="font-mono text-[11px] text-ink-faint">
          © 2026 The OpenVB Foundation
        </p>
      </div>
    </div>
  </div>
</footer>
