---
import Layout from '../layouts/Layout.astro';
import EditorWindow from '../components/EditorWindow.astro';
import LineNums from '../components/LineNums.astro';
---

<Layout
  title="500 — Server Error | OpenVB"
  description="Something went wrong on our end."
>
  <div class="min-h-screen bg-[#07090F] text-slate-100 overflow-x-hidden flex flex-col">

    <main class="flex-1 flex items-center justify-center px-6 lg:px-10 pt-32 pb-20">
      <div class="w-full max-w-5xl mx-auto">

        <!-- Background glow -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full"
            style="background: radial-gradient(circle, rgba(245,158,11,0.07) 0%, transparent 70%)"
          ></div>
        </div>

        <div class="relative z-10 grid lg:grid-cols-2 gap-16 items-center">

          <!-- Left: Editor -->
          <div class="fade-up">
            <EditorWindow
              filename="Server.vb"
              gradientFrom="rgba(245,158,11,0.35)"
              gradientTo="rgba(245,158,11,0.06)"
            >
              <LineNums count={14} />
              <div class="space-y-0">
                <div class="leading-7"><span class="text-[#569CD6]">Module</span> <span class="text-[#4EC9B0]">Server</span></div>
                <div class="leading-7 pl-8"><span class="text-[#569CD6]">Sub</span> <span class="text-[#DCDCAA]">HandleRequest</span>(<span class="text-[#9CDCFE]">req</span> <span class="text-[#569CD6]">As</span> <span class="text-[#4EC9B0]">Request</span>)</div>
                <div class="leading-7 pl-16"><span class="text-[#569CD6]">Try</span></div>
                <div class="leading-7 pl-24">
                  <span class="text-[#9CDCFE]">req</span>.<span class="text-[#DCDCAA]">Process</span>()
                </div>
                <div class="leading-7 pl-16"><span class="text-[#569CD6]">Catch</span> <span class="text-[#9CDCFE]">ex</span> <span class="text-[#569CD6]">As</span> <span class="text-[#4EC9B0]">Exception</span></div>
                <div class="leading-7 pl-24 relative">
                  <span class="text-[#6A9955]">' TODO: handle this properly</span>
                </div>
                <div class="leading-7 pl-24">
                  <span class="text-[#DCDCAA]">Throw</span> <span class="text-[#9CDCFE]">ex</span>
                  <span class="ml-3 text-[#F59E0B]">&#x25C0;&#xFE0E;</span>
                </div>
                <div class="leading-7 pl-16"><span class="text-[#569CD6]">End Try</span></div>
                <div class="leading-7 pl-8"><span class="text-[#569CD6]">End Sub</span></div>
                <div class="leading-7"><span class="text-[#569CD6]">End Module</span></div>
                <div class="leading-7">&nbsp;</div>
                <!-- Error output panel -->
                <div
                  class="mt-2 -mx-2 px-3 py-2.5 rounded-lg text-xs font-mono space-y-1.5"
                  style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.18)"
                >
                  <div class="flex items-start gap-2">
                    <span style="color: #F59E0B" class="shrink-0 mt-0.5">⚠</span>
                    <span class="text-slate-300">
                      <span style="color: #F59E0B" class="font-semibold">BC50500</span>
                      <span class="text-slate-500 mx-1">Server.vb(7,1):</span>
                      <span>Unhandled exception propagated to runtime.</span>
                    </span>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-[#F43F5E] shrink-0 mt-0.5">✕</span>
                    <span class="text-slate-400">
                      <span class="text-[#F43F5E] font-semibold">System.Exception</span>
                      <span class="text-slate-500 mx-1">—</span>
                      <span>An unexpected error occurred on the server.</span>
                    </span>
                  </div>
                  <div class="pt-1 text-slate-500 text-[11px]">
                    Runtime CRASHED · stack trace logged · our team is aware
                  </div>
                </div>
              </div>
            </EditorWindow>
          </div>

          <!-- Right: Copy -->
          <div class="space-y-7 fade-up" style="animation-delay: 0.1s">

            <div class="space-y-2">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold font-mono"
                style="background: rgba(245,158,11,0.12); color: #F59E0B; border: 1px solid rgba(245,158,11,0.2)"
              >
                <span>⚠</span> BC50500: Unhandled exception
              </div>

              <h1 class="text-8xl lg:text-9xl font-bold tracking-tighter leading-none" style="color: #F59E0B">
                500
              </h1>

              <h2 class="text-2xl lg:text-3xl font-bold text-white">
                Server error.
              </h2>
            </div>

            <p class="text-slate-400 leading-relaxed max-w-sm">
              Something went wrong on our end. We've been notified and are
              working on a fix — much like we work on VB.NET itself.
            </p>

            <div class="flex flex-wrap gap-3 pt-1">
              <a
                href="/"
                class="btn-glow px-6 py-3 rounded-xl font-semibold text-white text-sm transition-all duration-300"
                style="background: #00B4D8"
              >
                Go Home
              </a>
              <button
                onclick="window.location.reload()"
                class="px-6 py-3 rounded-xl font-semibold text-slate-300 text-sm border border-white/10 hover:bg-white/[0.05] hover:border-white/20 transition-all duration-200"
              >
                Try Again →
              </button>
            </div>

            <div
              class="flex items-center gap-3 text-xs font-mono text-slate-600 pt-2"
            >
              <span class="w-2 h-2 rounded-full bg-[#F59E0B]"></span>
              <span>Runtime CRASHED · team notified · <a href="https://github.com/OpenVBdotnet/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors underline underline-offset-2">report on GitHub</a></span>
            </div>
          </div>

        </div>
      </div>
    </main>

  </div>
</Layout>
