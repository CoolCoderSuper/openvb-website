---
import Layout from '../layouts/Layout.astro';

const CONTRIBUTION_WAYS = [
  {
    title: "Write Code",
    description: "Pick up an open issue on any of our projects. VB.NET preferred; TypeScript and C# welcome where the tooling needs them.",
    cta: "Browse open issues",
    href: "https://github.com/OpenVBdotnet/",
  },
  {
    title: "Write Docs",
    description: "Documentation matters as much as code. Tutorials, API references, and getting-started guides all need authors.",
    cta: "Docs on GitHub",
    href: "https://github.com/OpenVBdotnet/",
  },
  {
    title: "File Proposals",
    description: "Have an idea for a project, a language feature, or a tooling improvement? Open a discussion and make the case.",
    cta: "Open a discussion",
    href: "https://github.com/OpenVBdotnet/",
  },
  {
    title: "Review PRs",
    description: "Careful review keeps quality high and teaches newer contributors. It counts as much as writing the code.",
    cta: "View open PRs",
    href: "https://github.com/OpenVBdotnet/",
  },
  {
    title: "Advocate",
    description: "Write about VB.NET. Show a colleague. A language grows when people can see it working in public.",
    cta: "Share OpenVB",
    href: "https://github.com/OpenVBdotnet/",
  },
  {
    title: "Report Issues",
    description: "A clear bug report with a reproducer is one of the most valuable contributions a project can receive.",
    cta: "File an issue",
    href: "https://github.com/OpenVBdotnet/",
  },
];
---

<Layout
  title="Community — OpenVB Foundation"
  description="Join the OpenVB Foundation community. Find out how to contribute code, write docs, file proposals, and help build the future of Visual Basic."
>
  <div class="overflow-x-hidden">
    <!-- Hero -->
    <section class="pt-24 lg:pt-28 pb-20 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h1 class="rise font-serif text-5xl lg:text-6xl font-medium tracking-tight text-ink">
          Build it <em class="text-vb-blue">with us.</em>
        </h1>

        <p class="rise rise-1 text-lg text-ink-soft max-w-2xl leading-relaxed mt-7">
          Everything the foundation makes is built in public, by whoever shows up.
        </p>

        <div class="rise rise-2 grid md:grid-cols-2 gap-6 mt-12 max-w-4xl">
          <a
            href="https://discord.gg/p3w3ryST92"
            target="_blank"
            rel="noopener noreferrer"
            class="frame frame-link flex flex-col"
          >
            <div class="frame-header">
              <span class="frame-tab">
                <span class="w-2 h-2 bg-vb-blue shrink-0" aria-hidden="true"></span>
                Discord
              </span>
              <span class="ml-auto mr-3 my-auto text-ink-faint" aria-hidden="true">↗</span>
            </div>
            <div class="flex-1 bg-white px-5 py-5">
              <p class="text-ink-soft text-[15px] leading-relaxed">
                Questions, planning, and everyday conversation.
                If you're new, start here.
              </p>
            </div>
            <div class="frame-status">
              <span>discord.gg/p3w3ryST92</span>
            </div>
          </a>

          <a
            href="https://github.com/OpenVBdotnet/"
            target="_blank"
            rel="noopener noreferrer"
            class="frame frame-link flex flex-col"
          >
            <div class="frame-header">
              <span class="frame-tab">
                <span class="w-2 h-2 bg-vb-blue shrink-0" aria-hidden="true"></span>
                GitHub
              </span>
              <span class="ml-auto mr-3 my-auto text-ink-faint" aria-hidden="true">↗</span>
            </div>
            <div class="flex-1 bg-white px-5 py-5">
              <p class="text-ink-soft text-[15px] leading-relaxed">
                Code, issues, proposals, and reviews.
                Every repository is public.
              </p>
            </div>
            <div class="frame-status">
              <span>github.com/OpenVBdotnet</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Ways to contribute -->
    <section class="pb-28 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-4xl lg:text-5xl font-medium tracking-tight text-ink mb-14">
          How to contribute
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 border-t border-l border-rule">
          {CONTRIBUTION_WAYS.map((way) => (
            <a
              href={way.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-4 p-7 border-b border-r border-rule hover:bg-paper-raised transition-colors"
            >
              <div class="flex-1">
                <h3 class="font-serif text-xl font-medium text-ink mb-2 group-hover:text-vb-blue transition-colors">
                  {way.title}
                </h3>
                <p class="text-ink-soft text-[15px] leading-relaxed">{way.description}</p>
              </div>

              <div class="font-mono text-[12px] uppercase tracking-[0.1em] text-ink-faint group-hover:text-vb-blue transition-colors">
                {way.cta} →
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</Layout>
