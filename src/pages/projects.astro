---
import Layout from '../layouts/Layout.astro';

const PROJECTS = [
  {
    name: "openvb-analyzers",
    description: "Roslyn analyzers for VB.NET that flag outdated patterns and suggest current idioms, with automatic code fixes where possible.",
    category: "Tooling",
    status: "Active" as const,
  },
  {
    name: "vb-templates",
    description: "dotnet new templates for VB.NET: console apps, class libraries, web APIs, and test projects that build and run out of the box.",
    category: "Tooling",
    status: "Active" as const,
  },
  {
    name: "openvb.net",
    description: "This website. Every page is open source and accepts pull requests.",
    category: "Infrastructure",
    status: "Active" as const,
  },
  {
    name: "vbfmt",
    description: "A zero-config code formatter for VB.NET in the spirit of Prettier: one canonical style, applied automatically.",
    category: "Tooling",
    status: "Planning" as const,
  },
  {
    name: "vscode-vb",
    description: "A VS Code extension for VB.NET: IntelliSense, diagnostics, formatting, and debugging in the editor most developers already use.",
    category: "Tooling",
    status: "Planning" as const,
  },
  {
    name: "openvb-spec",
    description: "A community-written specification for the Visual Basic language, independent of any single implementation. The foundation for the eventual fork.",
    category: "Compiler",
    status: "Research" as const,
  },
];

const STATUS_STYLE = {
  Active:   { text: "text-vb-green", square: "bg-vb-green" },
  Planning: { text: "text-vb-blue",  square: "bg-vb-blue" },
  Research: { text: "text-ink-faint", square: "bg-ink-faint" },
} as const;
---

<Layout
  title="Projects — OpenVB Foundation"
  description="Open-source projects built by the OpenVB Foundation. Libraries, tooling, templates, and the future compiler — all written in VB.NET and accepting contributions."
>
  <div class="overflow-x-hidden">
    <!-- Hero -->
    <section class="pt-24 lg:pt-28 pb-16 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h1 class="rise font-serif text-5xl lg:text-6xl font-medium tracking-tight text-ink">
          What we're <em class="text-vb-blue">building.</em>
        </h1>
        <p class="rise rise-1 text-lg text-ink-soft max-w-2xl leading-relaxed mt-7">
          Tooling, templates, and the groundwork for an independent compiler —
          every repository public, every project accepting pull requests.
        </p>
      </div>
    </section>

    <!-- Projects -->
    <section class="pb-24 px-6 lg:px-8">
      <div class="rise rise-2 max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PROJECTS.map((project) => {
          const style = STATUS_STYLE[project.status];
          return (
            <a
              href="https://github.com/OpenVBdotnet/"
              target="_blank"
              rel="noopener noreferrer"
              class="frame frame-link flex flex-col"
            >
              <div class="frame-header">
                <span class="frame-tab">
                  <span class={`w-2 h-2 shrink-0 ${style.square}`} aria-hidden="true"></span>
                  {project.name}
                </span>
                <span class="ml-auto mr-3 my-auto text-ink-faint" aria-hidden="true">↗</span>
              </div>

              <div class="flex-1 bg-code-bg px-5 py-5">
                <p class="text-ink-soft text-[15px] leading-relaxed">
                  {project.description}
                </p>
              </div>

              <div class="frame-status">
                <span class={style.text}>{project.status}</span>
                <span class="flex-1"></span>
                <span>{project.category}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 px-6 lg:px-8 border-t border-ink">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-3xl lg:text-4xl font-medium tracking-tight text-ink mb-5">
          Have an idea for a project?
        </h2>
        <p class="text-ink-soft leading-relaxed text-lg max-w-2xl mb-8">
          If you think a VB.NET open-source project should exist,
          open a discussion and make the case.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/OpenVBdotnet/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Propose on GitHub
          </a>
          <a href="/community" class="btn-secondary">Join the Community</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
