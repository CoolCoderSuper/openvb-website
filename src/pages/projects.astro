---
import Layout from '../layouts/Layout.astro';

const PROJECTS = [
  {
    id: "openvb-analyzers",
    name: "openvb-analyzers",
    description: "A suite of Roslyn analyzers for VB.NET — enforcing modern patterns, flagging anti-patterns, and guiding developers toward idiomatic, maintainable VB code.",
    category: "Tooling",
    status: "Active" as const,
    accent: "#00B4D8",
    tags: ["Roslyn", "Analyzer", "Code Quality"],
  },
  {
    id: "vb-templates",
    name: "vb-templates",
    description: "First-class `dotnet new` templates for VB.NET: console apps, class libraries, web APIs, xUnit test projects, and more — ready to clone and run.",
    category: "Tooling",
    status: "Active" as const,
    accent: "#10B981",
    tags: ["dotnet", "Templates", "CLI"],
  },
  {
    id: "openvb.net",
    name: "openvb.net",
    description: "This website. Built with Astro by the community — every page, every word, and every pixel is open source and accepting pull requests.",
    category: "Infrastructure",
    status: "Active" as const,
    accent: "#60A5FA",
    tags: ["Astro", "Web", "Meta"],
  },
  {
    id: "vbfmt",
    name: "vbfmt",
    description: "An opinionated, zero-config code formatter for VB.NET — think Prettier but for Visual Basic. Consistent style, everywhere, automatically.",
    category: "Tooling",
    status: "Planning" as const,
    accent: "#F59E0B",
    tags: ["Formatter", "Code Style", "CLI"],
  },
  {
    id: "vscode-vb",
    name: "vscode-vb",
    description: "A modern, fully-featured VS Code extension for VB.NET with first-class IntelliSense, live diagnostics, formatting, and integrated debugging support.",
    category: "Tooling",
    status: "Planning" as const,
    accent: "#A855F7",
    tags: ["VS Code", "Extension", "IDE"],
  },
  {
    id: "openvb-spec",
    name: "openvb-spec",
    description: "The long game. A community-driven language specification for Visual Basic beyond .NET — the foundation upon which the OpenVB fork will be built.",
    category: "Compiler",
    status: "Research" as const,
    accent: "#F43F5E",
    tags: ["Specification", "Language Design", "Phase 3"],
  },
];

const STATUS_CONFIG = {
  Active:   { color: "#28C840", label: "Active"   },
  Planning: { color: "#F59E0B", label: "Planning" },
  Research: { color: "#F43F5E", label: "Research" },
} as const;

type Status = keyof typeof STATUS_CONFIG;
const STATUS_ORDER: Status[] = ["Active", "Planning", "Research"];
---

<Layout
  title="Projects — OpenVB Foundation"
  description="Open-source projects built by the OpenVB Foundation. Libraries, tooling, templates, and the future compiler — all written in VB.NET and accepting contributions."
>
  <div class="min-h-screen bg-[#07090F] text-slate-100 overflow-x-hidden">
    <!-- Hero -->
    <section class="relative pt-36 pb-20 px-6 lg:px-10">
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(180deg, #0D1033 0%, #07090F 70%)"
      ></div>
      <div class="absolute inset-0 grid-bg pointer-events-none"></div>
      <div
        class="absolute top-20 left-[20%] w-[700px] h-[400px] rounded-full pointer-events-none"
        style="background: radial-gradient(circle, rgba(0,180,216,0.08) 0%, transparent 70%)"
      ></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <h1 class="text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight tracking-tight">
          What we're building
        </h1>
        <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
          Every project is open source, every decision is public, and every contributor
          matters. Browse what the OpenVB Foundation is working on — and find your place in it.
        </p>
      </div>
    </section>

    <!-- Project groups -->
    <section class="py-4 pb-24 px-6 lg:px-10">
      <div class="max-w-7xl mx-auto space-y-20">
        {STATUS_ORDER.map((status) => {
          const group = PROJECTS.filter((p) => p.status === status);
          if (group.length === 0) return null;
          const cfg = STATUS_CONFIG[status];

          return (
            <div>
              <div class="flex items-center gap-4 mb-8">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full" style={`background: ${cfg.color}`}></span>
                  <h2
                    class="text-sm font-semibold uppercase tracking-widest"
                    style={`color: ${cfg.color}`}
                  >
                    {cfg.label}
                  </h2>
                </div>
                <div class="flex-1 h-px bg-white/[0.05]"></div>
                <span class="text-xs text-slate-600">
                  {group.length} project{group.length !== 1 ? "s" : ""}
                </span>
              </div>

              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                {group.map((project) => (
                  <a
                    href="https://github.com/OpenVBdotnet/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group p-6 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.14] hover:-translate-y-0.5 transition-all duration-300 flex flex-col gap-4"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <span class="font-mono text-sm font-semibold text-white truncate">
                        {project.name}
                      </span>
                      <svg
                        class="w-4 h-4 text-slate-600 group-hover:text-slate-400 transition-colors shrink-0 mt-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </div>

                    <p class="text-slate-400 text-sm leading-relaxed flex-1">
                      {project.description}
                    </p>

                    <div class="flex flex-wrap gap-1.5">
                      {project.tags.map((tag) => (
                        <span class="px-2 py-0.5 rounded text-xs text-slate-500 bg-white/[0.04] border border-white/[0.06]">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <section
      class="py-24 px-6 lg:px-10 border-t border-white/[0.05]"
      style="background: linear-gradient(180deg, rgba(13,16,51,0.4) 0%, transparent 100%)"
    >
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl lg:text-4xl font-bold text-white">
          Have an idea for a project?
        </h2>
        <p class="text-slate-400 leading-relaxed text-lg">
          OpenVB Foundation is community-driven. If you think a VB.NET open-source project
          should exist, open a discussion and let's build it together.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a
            href="https://github.com/OpenVBdotnet/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-glow px-6 py-3 rounded-xl font-semibold text-white text-sm transition-all duration-300"
            style="background: #00B4D8"
          >
            Propose on GitHub
          </a>
          <a
            href="/community"
            class="px-6 py-3 rounded-xl font-semibold text-slate-300 text-sm border border-white/10 hover:bg-white/[0.05] hover:border-white/20 transition-all duration-200"
          >
            Join the Community →
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
