---
import Layout from '../layouts/Layout.astro';
import EditorWindow from '../components/EditorWindow.astro';

const helloWorldCode = `Module HelloWorld
    Sub Main()
        ' Welcome to VB.NET!
        Dim name As String = "World"
        Console.WriteLine($"Hello, {name}!")
    End Sub
End Module`;

const releaseFeedCode = `Imports System.Net.Http.Json

Public Class ReleaseFeed
    Private ReadOnly _http As New HttpClient()

    Public Async Function LatestAsync(repo As String) _
            As Task(Of GitRelease)
        Dim url = $"https://api.github.com/repos/{repo}/releases/latest"
        Return Await _http.GetFromJsonAsync(Of GitRelease)(url)
    End Function
End Class`;

const features = [
  {
    title: "Community Projects",
    description: "Real software written in VB.NET — libraries, tools, and applications that prove the language on today's .NET.",
  },
  {
    title: "Modern Tooling",
    description: "Analyzers, formatters, templates, and editor support, so VB feels first-class in the editors people actually use.",
  },
  {
    title: "Living Documentation",
    description: "Current, accurate docs written by people who use the language — from first install to production patterns.",
  },
  {
    title: "Language Advocacy",
    description: "Proposals, issues, and public pressure for VB to receive the same investment as C#.",
  },
  {
    title: "The OpenVB Fork",
    description: "Groundwork for an independent, community-owned specification, compiler, and runtime — ready if Microsoft walks away.",
  },
  {
    title: "Open Governance",
    description: "Every repository public, every decision in the open. The foundation belongs to its contributors.",
  },
];

const codeItems = [
  "Libraries and NuGet packages, written in VB",
  "Analyzers, formatters, and project templates",
  "Reference apps that document patterns by example",
  "All of it on GitHub, all of it accepting PRs",
];

const roadmapPhases = [
  {
    number: "01",
    title: "Community & Projects",
    description: "Gather contributors, launch open-source VB.NET projects, ship tooling improvements, and write the documentation the language deserves.",
    items: ["Open-source project launches", "Contributor community", "Docs & tutorials", "VS Code extension improvements"],
  },
  {
    number: "02",
    title: "Language Evolution",
    description: "Push VB forward within the .NET ecosystem: language proposals, a growing analyzer suite, and a campaign for parity with C#.",
    items: ["Language feature proposals", "Roslyn analyzer suite", "C# feature parity campaign", "Community governance structure"],
  },
  {
    number: "03",
    title: "The OpenVB Fork",
    description: "An independent Visual Basic: a community-owned spec, an open compiler, and a language that evolves because its users want it to.",
    items: ["OpenVB language specification", "Independent compiler project", "Community-governed RFC process", "VB, owned by its users"],
  },
];
---

<Layout
  title="OpenVB — Visual Basic for Everyone"
  description="OpenVB Foundation — the home of Visual Basic .NET. Simple enough for beginners. Powerful enough for production. Join the community keeping VB alive and modern."
  keywords={["VB.NET", "Visual Basic", "OpenVB", ".NET", "programming", "open source"]}
>
  <div class="overflow-x-hidden">

    <!-- HERO -->
    <section class="pt-24 lg:pt-28 pb-24 lg:pb-32 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_1fr] gap-14 lg:gap-16 items-center">

        <!-- Left: Copy -->
        <div>
          <h1 class="rise font-serif text-5xl lg:text-6xl xl:text-7xl font-medium leading-[1.04] tracking-tight text-ink">
            Visual Basic has<br />
            a <em class="text-vb-blue">future.</em>
          </h1>

          <p class="rise rise-2 text-lg text-ink-soft max-w-lg leading-relaxed mt-7">
            We're building it: open-source projects, serious tooling, and the
            groundwork to carry VB.NET forward for the next thirty years —
            with or without Microsoft.
          </p>

          <div class="rise rise-3 flex flex-wrap items-center gap-4 mt-9">
            <a href="/community" class="btn-primary">Join the Foundation</a>
            <a href="/roadmap" class="btn-secondary">Read the Roadmap</a>
          </div>

          <p class="rise rise-4 font-mono text-[12px] text-ink-faint mt-9 tracking-wide">
            Cross-platform&ensp;·&ensp;100% open source&ensp;·&ensp;Free forever
          </p>
        </div>

        <!-- Right: Editor -->
        <div class="rise rise-2 w-full">
          <EditorWindow filename="HelloWorld.vb" code={helloWorldCode} />
        </div>
      </div>
    </section>

    <!-- MISSION INDEX -->
    <section class="pb-24 lg:pb-32 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-4xl lg:text-5xl font-medium tracking-tight text-ink mb-14">
          What the foundation does
        </h2>

        <div class="grid md:grid-cols-2 gap-x-16">
          {features.map((f) => (
            <div class="group py-7 border-b border-rule">
              <h3 class="font-serif text-xl font-medium text-ink mb-2 group-hover:text-vb-blue transition-colors">
                {f.title}
              </h3>
              <p class="text-ink-soft text-[15px] leading-relaxed">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CODE SHOWCASE -->
    <section class="pb-24 lg:pb-32 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">

        <div class="lg:order-2">
          <h2 class="font-serif text-4xl lg:text-5xl font-medium tracking-tight text-ink leading-tight">
            Working software is the argument.
          </h2>
          <p class="text-ink-soft leading-relaxed mt-6">
            The clearest way to prove a language has a future is to keep building
            with it. The foundation maintains libraries, tools, and applications
            written entirely in VB.NET — async, LINQ, generics, and all — running
            on current .NET, on any operating system.
          </p>
          <ul class="mt-7 space-y-3">
            {codeItems.map((item) => (
              <li class="flex items-baseline gap-4 text-[15px] text-ink">
                <span class="font-mono text-vb-blue text-[13px] shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
          <a href="/projects" class="link-plain inline-block font-mono text-[13px] mt-7">
            Browse the projects →
          </a>
        </div>

        <div class="lg:order-1">
          <EditorWindow filename="ReleaseFeed.vb" code={releaseFeedCode} />
        </div>
      </div>
    </section>

    <!-- INDEPENDENCE MANIFESTO -->
    <section class="py-24 lg:py-32 px-6 lg:px-8 bg-ink">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-serif text-4xl lg:text-6xl font-medium tracking-tight leading-[1.1] text-paper">
          If Microsoft won't take VB forward, <em class="text-vb-blue-soft">we will.</em>
        </h2>

        <div class="grid md:grid-cols-2 gap-8 mt-10">
          <p class="leading-relaxed text-paper/75">
            New language features arrive in C# first — or never reach VB at all.
            We think a language carrying three decades of working software
            deserves better than maintenance mode.
          </p>
          <p class="leading-relaxed text-paper/75">
            So we're preparing for the long game: an independent specification,
            an open compiler, and governance that belongs to the people who
            actually write VB.
          </p>
        </div>

        <a
          href="/roadmap"
          class="inline-block font-mono text-[13px] mt-10 underline underline-offset-4 decoration-1 transition-colors text-vb-blue-soft hover:text-paper"
        >
          Read the plan →
        </a>
      </div>
    </section>

    <!-- ROADMAP -->
    <section class="py-24 lg:py-32 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-4xl lg:text-5xl font-medium tracking-tight text-ink mb-14">
          Where we're going
        </h2>

        <div class="grid md:grid-cols-3 border-t border-ink divide-y md:divide-y-0 md:divide-x divide-rule">
          {roadmapPhases.map((phase, i) => (
            <div class="py-8 md:px-8 first:md:pl-0 last:md:pr-0 flex flex-col gap-5">
              <span class={`font-serif text-6xl font-medium ${i === 0 ? "text-ink" : "num-ghost"}`}>
                {phase.number}
              </span>
              <div>
                <h3 class="font-serif text-2xl font-medium text-ink mb-3">{phase.title}</h3>
                <p class="text-ink-soft text-[15px] leading-relaxed">{phase.description}</p>
              </div>
              <ul class="space-y-2 pt-4 border-t border-rule mt-auto">
                {phase.items.map((item) => (
                  <li class="flex items-baseline gap-3 text-sm text-ink-soft">
                    <span class="font-mono text-vb-blue text-xs shrink-0">→</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <a href="/roadmap" class="link-plain inline-block font-mono text-[13px] mt-10">
          See the full roadmap with milestones →
        </a>
      </div>
    </section>

    <!-- JOIN CTA -->
    <section class="py-24 lg:py-32 px-6 lg:px-8 border-t border-ink">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.15fr_1fr] gap-14 lg:gap-20 items-center">
        <div>
          <h2 class="font-serif text-4xl lg:text-6xl font-medium tracking-tight text-ink leading-[1.08]">
            Help decide what Visual Basic <em class="text-vb-blue">becomes next.</em>
          </h2>
          <p class="text-ink-soft text-lg leading-relaxed mt-7 max-w-xl">
            We don't take applications. If you write VB, or you set it down
            when the language went quiet, you're the person this is for.
          </p>
          <div class="flex flex-wrap gap-4 mt-9">
            <a href="/community" class="btn-primary">Join the Foundation</a>
            <a
              href="https://github.com/OpenVBdotnet/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              Projects on GitHub
            </a>
          </div>
        </div>

        <!-- Cross-platform terminal -->
        <div class="frame frame-dark">
          <div class="frame-header">
            <span class="frame-tab">
              <span class="w-2 h-2 bg-vb-blue shrink-0" aria-hidden="true"></span>
              ~/my-app
            </span>
          </div>
          <div class="font-mono text-[13px] leading-6 px-5 py-5 overflow-x-auto" style="color: var(--term-fg)">
            <div class="opacity-50"># works the same on Linux, macOS, and Windows</div>
            <div class="mt-3"><span class="text-vb-green">$</span> <span class="text-white">dotnet new console --language VB -n MyApp</span></div>
            <div><span class="text-vb-green">$</span> <span class="text-white">cd MyApp</span></div>
            <div><span class="text-vb-green">$</span> <span class="text-white">dotnet run</span></div>
            <div class="mt-2" style="color: #6FBF6F">Hello, World!</div>
            <div class="mt-1"><span class="text-vb-green">$</span> <span class="cursor-blink">▌</span></div>
          </div>
          <div class="frame-status">
            <span>dotnet 10.0</span>
            <span class="flex-1"></span>
            <span class="hidden sm:inline">linux-x64 · osx-arm64 · win-x64</span>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
