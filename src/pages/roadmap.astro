---
import Layout from '../layouts/Layout.astro';
import CheckIcon from '../components/CheckIcon.astro';

const PHASES = [
  {
    number: "01",
    title: "Community & Projects",
    description: "Build the foundation. Gather contributors, ship open-source VB.NET projects, improve the developer experience, and write documentation the language actually deserves.",
    milestones: [
      { label: "Launch OpenVB Foundation",         done: true,  active: false },
      { label: "Establish GitHub organization",    done: true,  active: false },
      { label: "Publish openvb.net website",       done: true,  active: false },
      { label: "Launch openvb-analyzers project",  done: false, active: true  },
      { label: "Launch vb-templates project",      done: false, active: true  },
      { label: "Ship first NuGet packages",        done: false, active: false },
      { label: "Recruit 10 core contributors",     done: false, active: false },
      { label: "Modern getting-started guide",     done: false, active: false },
      { label: "VS Code extension improvements",   done: false, active: false },
      { label: "Community Discord server",         done: false, active: false },
    ],
  },
  {
    number: "02",
    title: "Language Evolution",
    description: "Push VB forward within the .NET ecosystem. File language proposals, advocate for parity with C#, expand the analyzer suite, and establish formal community governance.",
    milestones: [
      { label: "First language feature proposals filed",        done: false, active: false },
      { label: "Roslyn analyzer suite v2",                      done: false, active: false },
      { label: "C# language parity campaign launch",            done: false, active: false },
      { label: "Community governance structure (RFC process)",  done: false, active: false },
      { label: "First OpenVB community summit",                 done: false, active: false },
      { label: "vbfmt formatter — first stable release",       done: false, active: false },
      { label: "vscode-vb extension — first release",          done: false, active: false },
      { label: "VB.NET pattern library & cookbook",             done: false, active: false },
    ],
  },
  {
    number: "03",
    title: "The OpenVB Fork",
    description: "The long game. A community-owned language specification, an independent compiler, and a self-governing RFC process — a Visual Basic owned by the people who use it.",
    milestones: [
      { label: "OpenVB language specification (draft)",  done: false, active: false },
      { label: "Independent compiler project kickoff",   done: false, active: false },
      { label: "Community-governed RFC process",         done: false, active: false },
      { label: "Runtime research & prototyping",         done: false, active: false },
      { label: "OpenVB v0.1 — proof of concept",        done: false, active: false },
      { label: "VB, owned by its users",                 done: false, active: false },
    ],
  },
] as const;

const phase1 = PHASES[0];
const doneCount  = phase1.milestones.filter((m) => m.done).length;
const totalCount = phase1.milestones.length;
const pct = Math.round((doneCount / totalCount) * 100);
// Classic segmented progress bar, one block per 5%
const SEGMENTS = 20;
const filledSegments = Math.round((pct / 100) * SEGMENTS);
---

<Layout
  title="Roadmap — OpenVB Foundation"
  description="The OpenVB Foundation roadmap: what we're working on now, what's next, and the path to an independent, community-owned Visual Basic."
>
  <div class="overflow-x-hidden">
    <!-- Hero -->
    <section class="pt-24 lg:pt-28 pb-16 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h1 class="rise font-serif text-5xl lg:text-6xl font-medium tracking-tight text-ink">
          Where we're going
        </h1>
      </div>
    </section>

    <!-- Phases -->
    <section class="pb-28 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        {PHASES.map((phase, phaseIdx) => {
          const isCurrent = phaseIdx === 0;
          return (
            <div class="border-t border-ink py-12 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-10 lg:gap-16">
              <!-- Left column: phase identity -->
              <div>
                <div class="flex items-baseline gap-4 mb-5">
                  {isCurrent ? (
                    <span class="font-serif text-7xl font-medium leading-none text-ink">
                      {phase.number}
                    </span>
                  ) : (
                    <span class="font-serif text-7xl font-medium leading-none text-rule" style="-webkit-text-stroke: 1px var(--ink-faint)">
                      {phase.number}
                    </span>
                  )}
                  {isCurrent && (
                    <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-vb-blue">
                      Current phase
                    </span>
                  )}
                </div>

                <h2 class="font-serif text-3xl font-medium tracking-tight text-ink mb-4">{phase.title}</h2>
                <p class="text-ink-soft leading-relaxed text-[15px]">{phase.description}</p>

                {isCurrent && (
                  <div class="mt-8">
                    <div class="flex items-baseline justify-between font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint mb-2">
                      <span>Progress</span>
                      <span class="text-vb-blue">{doneCount}/{totalCount} milestones · {pct}%</span>
                    </div>
                    <div class="flex gap-[3px] p-[4px] bg-white border border-rule" aria-hidden="true">
                      {Array.from({ length: SEGMENTS }, (_, i) => (
                        <span
                          class="h-4 flex-1"
                          style={`background: ${i < filledSegments ? "var(--vb-blue)" : "var(--rule)"}`}
                        ></span>
                      ))}
                    </div>
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 mt-3 font-mono text-[11px] text-ink-faint">
                      <span class="flex items-center gap-1.5"><CheckIcon done={true} /> done</span>
                      <span class="flex items-center gap-1.5"><CheckIcon done={false} active={true} /> in progress</span>
                      <span class="flex items-center gap-1.5"><CheckIcon done={false} /> planned</span>
                    </div>
                  </div>
                )}
              </div>

              <!-- Right column: milestones -->
              {isCurrent ? (
                <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-2.5 content-start lg:pt-2">
                  {phase.milestones.map((milestone) => (
                    <li class="flex items-center gap-3.5 text-[15px] py-0.5">
                      <CheckIcon done={milestone.done} active={milestone.active} />
                      <span
                        class={
                          milestone.done
                            ? "text-ink-faint line-through decoration-1"
                            : milestone.active
                            ? "text-ink font-medium"
                            : "text-ink-soft"
                        }
                      >
                        {milestone.label}
                      </span>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-2.5 content-start lg:pt-2">
                  {phase.milestones.map((milestone) => (
                    <li class="flex items-baseline gap-3.5 text-[15px] py-0.5 text-ink-soft">
                      <span class="font-mono text-vb-blue text-xs shrink-0">→</span>
                      {milestone.label}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 px-6 lg:px-8 border-t border-ink">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-serif text-3xl lg:text-4xl font-medium tracking-tight text-ink mb-5">
          Help us hit these milestones
        </h2>
        <p class="text-ink-soft leading-relaxed text-lg max-w-2xl mb-8">
          Every item on this roadmap moves faster with more contributors. Pick a project,
          open an issue, or just introduce yourself in the community.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/projects" class="btn-primary">Browse Projects</a>
          <a href="/community" class="btn-secondary">Join the Community</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
