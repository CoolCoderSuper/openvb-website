---
import Layout from '../layouts/Layout.astro';
import EditorWindow from '../components/EditorWindow.astro';
import LineNums from '../components/LineNums.astro';
---

<Layout
  title="404 — Page Not Found | OpenVB"
  description="The page you're looking for doesn't exist."
>
  <div class="min-h-screen bg-[#07090F] text-slate-100 overflow-x-hidden flex flex-col">

    <main class="flex-1 flex items-center justify-center px-6 lg:px-10 pt-32 pb-20">
      <div class="w-full max-w-5xl mx-auto">

        <!-- Background glow -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full"
            style="background: radial-gradient(circle, rgba(244,63,94,0.07) 0%, transparent 70%)"
          ></div>
        </div>

        <div class="relative z-10 grid lg:grid-cols-2 gap-16 items-center">

          <!-- Left: Editor -->
          <div class="fade-up">
            <EditorWindow
              filename="Router.vb"
              gradientFrom="rgba(244,63,94,0.35)"
              gradientTo="rgba(244,63,94,0.06)"
            >
              <LineNums count={12} />
              <div class="space-y-0">
                <div class="leading-7"><span class="text-[#569CD6]">Module</span> <span class="text-[#4EC9B0]">Router</span></div>
                <div class="leading-7 pl-8"><span class="text-[#569CD6]">Sub</span> <span class="text-[#DCDCAA]">Navigate</span>(<span class="text-[#9CDCFE]">path</span> <span class="text-[#569CD6]">As</span> <span class="text-[#4EC9B0]">String</span>)</div>
                <div class="leading-7 pl-16"><span class="text-[#569CD6]">Dim</span> <span class="text-[#9CDCFE]">page</span> <span class="text-[#569CD6]">As</span> <span class="text-[#4EC9B0]">Page</span> = <span class="text-[#DCDCAA]">FindPage</span>(<span class="text-[#9CDCFE]">path</span>)</div>
                <div class="leading-7 pl-16 relative">
                  <span class="text-[#9CDCFE]">page</span>.<span class="text-[#DCDCAA]">Render</span>()
                  <span class="absolute bottom-0 left-16 right-0 h-0.5 bg-[#F43F5E]/60 pointer-events-none"></span>
                </div>
                <div class="leading-7 pl-8"><span class="text-[#569CD6]">End Sub</span></div>
                <div class="leading-7"><span class="text-[#569CD6]">End Module</span></div>
                <div class="leading-7">&nbsp;</div>
                <!-- Error output panel -->
                <div
                  class="mt-2 -mx-2 px-3 py-2.5 rounded-lg text-xs font-mono space-y-1.5"
                  style="background: rgba(244,63,94,0.08); border: 1px solid rgba(244,63,94,0.18)"
                >
                  <div class="flex items-start gap-2">
                    <span style="color: #F43F5E" class="shrink-0 mt-0.5">✕</span>
                    <span class="text-slate-300">
                      <span style="color: #F43F5E" class="font-semibold">BC40404</span>
                      <span class="text-slate-500 mx-1">Router.vb(4,13):</span>
                      <span>'page' resolved to Nothing — resource not found.</span>
                    </span>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-[#F59E0B] shrink-0 mt-0.5">⚠</span>
                    <span class="text-slate-400">
                      <span class="text-[#F59E0B] font-semibold">BC40001</span>
                      <span class="text-slate-500 mx-1">Router.vb(4,1):</span>
                      <span>NullReferenceException will be thrown at runtime.</span>
                    </span>
                  </div>
                  <div class="pt-1 text-slate-500 text-[11px]">
                    Build FAILED — 1 error, 1 warning
                  </div>
                </div>
              </div>
            </EditorWindow>
          </div>

          <!-- Right: Copy -->
          <div class="space-y-7 fade-up" style="animation-delay: 0.1s">

            <div class="space-y-2">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold font-mono"
                style="background: rgba(244,63,94,0.12); color: #F43F5E; border: 1px solid rgba(244,63,94,0.2)"
              >
                <span>✕</span> BC40404: Resource not found
              </div>

              <h1 class="text-8xl lg:text-9xl font-bold tracking-tighter leading-none" style="color: #F43F5E">
                404
              </h1>

              <h2 class="text-2xl lg:text-3xl font-bold text-white">
                Page not found.
              </h2>
            </div>

            <p class="text-slate-400 leading-relaxed max-w-sm">
              The page you're looking for doesn't exist or has been moved.
              Even VB compile errors are more helpful than this URL.
            </p>

            <div class="flex flex-wrap gap-3 pt-1">
              <a
                href="/"
                class="btn-glow px-6 py-3 rounded-xl font-semibold text-white text-sm transition-all duration-300"
                style="background: #00B4D8"
              >
                Go Home
              </a>
              <a
                href="/projects"
                class="px-6 py-3 rounded-xl font-semibold text-slate-300 text-sm border border-white/10 hover:bg-white/[0.05] hover:border-white/20 transition-all duration-200"
              >
                Browse Projects →
              </a>
            </div>

            <div
              class="flex items-center gap-3 text-xs font-mono text-slate-600 pt-2"
            >
              <span class="w-2 h-2 rounded-full bg-[#F43F5E]"></span>
              <span>Build FAILED · 1 error · <a href="/" class="hover:text-slate-400 transition-colors underline underline-offset-2">return to safety</a></span>
            </div>
          </div>

        </div>
      </div>
    </main>

  </div>
</Layout>
