---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | OpenVB"
  description="The page you're looking for doesn't exist."
>
  <main class="flex-1 flex items-center justify-center px-6 lg:px-8 pt-32 pb-24">
    <div class="w-full max-w-xl mx-auto text-center">

      <h1 class="rise font-serif text-5xl lg:text-6xl font-medium tracking-tight text-ink mb-10">
        Page not <em class="text-vb-maroon">found.</em>
      </h1>

      <!-- Compiler diagnostic -->
      <div class="rise rise-2 frame text-left mx-auto max-w-lg">
        <div class="frame-header">
          <span class="frame-tab">
            <span class="w-2 h-2 bg-vb-maroon shrink-0" aria-hidden="true"></span>
            build output
          </span>
        </div>
        <div class="font-mono text-[13px] leading-6 bg-code-bg px-5 py-5 overflow-x-auto">
          <div class="text-ink-faint">$ openvb resolve --route ./this-page</div>
          <div class="mt-3">
            <span class="text-vb-maroon font-semibold">error BC40404</span><span class="text-ink-faint">:</span>
            <span class="text-ink"> Page not found.</span>
          </div>
          <div class="text-ink-faint pl-4">at Router.Navigate(path As String)</div>
          <div class="mt-3 text-ink-soft">Build <span class="text-vb-maroon font-semibold">FAILED</span> — 1 error, 0 warnings</div>
        </div>
        <div class="frame-status">
          <span class="text-vb-maroon">✕ 1 error</span>
          <span class="flex-1"></span>
          <span class="hidden sm:inline">Ln 404, Col 1</span>
        </div>
      </div>

      <div class="rise rise-3 flex flex-wrap justify-center gap-4 mt-10">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/projects" class="btn-secondary">Browse Projects</a>
      </div>

      <p class="rise rise-4 font-mono text-[12px] text-ink-faint mt-8">
        Even VB compile errors are more helpful than this URL.
      </p>

    </div>
  </main>
</Layout>
